{
  "manifest_version": 3,
  "name": "Zendo Grip Menu Switch",
  "version": "0.1.0",
  "description": "Switches a separately installed Firefox sidebar drag stylesheet on or off.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zendo-grip-menu-switch@firefox-sidebar-tools.invalid",
      "strict_min_version": "159.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icon.svg" },
  "action": {
    "default_icon": "icon.svg",
    "default_title": "Zendo Grip — Off",
    "default_area": "menupanel"
  },
  "background": { "scripts": ["background.js"] }
}
