{
  "manifest_version": 3,
  "name": "Minus — Tab Unloader",
  "version": "1.0.0",
  "description": "Unload the current tab with a minus button or Alt+Shift+U. Keeps Firefox's native sidebar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{87acebb7-54bf-44a7-93d5-6229ab1a3ab6}",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "minus.svg", "96": "minus.svg" },
  "action": {
    "default_title": "Unload current tab (Alt+Shift+U)",
    "default_icon": "minus.svg"
  },
  "background": { "scripts": ["unload.js", "background.js"] },
  "commands": {
    "unload-current-tab": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Unload current tab"
    }
  }
}
